# Copy to .env and fill in. Never commit .env.
# Variables marked (required) are checked at startup by validateEnv().

# --- server ---
PORT=5000
# Extra allowed CORS origin (localhost:3000 / 127.0.0.1:3000 are always allowed)
CLIENT_URL=http://localhost:3000

# --- auth (required) ---
JWT_SECRET=change-me
JWT_EXP_TIME=15m

# --- Cloudinary (required) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- database (required) ---
# NOTE: dev and prod use the same variable/database. Point it somewhere safe
# before running the seed script or any write.
MONGODB_URI_PROD=

# --- first superadmin (used by superAdmin.ts only) ---
SuperAdminEmail=
SuperAdminPassword=

# --- frontend cache revalidation (optional) ---
# When the backend saves news, categories, settings, homepage or pages it
# notifies the frontend so the public site refreshes immediately instead of
# within ~60s. Leave FRONTEND_REVALIDATE_URL unset (local development) to
# disable it. If it IS set, REVALIDATE_SECRET is required too, and must equal
# the frontend's REVALIDATE_SECRET. Server-side only; never expose it to a browser.
# Base URL only - "/api/revalidate" is appended. Example: http://localhost:3000
FRONTEND_REVALIDATE_URL=
REVALIDATE_SECRET=
