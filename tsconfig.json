{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "types" : ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["server.ts", "superAdmin.ts", "src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
